# DARAI configuration. Copy to .env and adjust. No secrets in git.
# Every variable maps to backend/app/config.py (case-insensitive).

# --- first admin (created only when the users table is empty) ---
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-now

# --- database (compose builds DATABASE_URL from these) ---
POSTGRES_USER=darai
POSTGRES_PASSWORD=darai
POSTGRES_DB=darai
# Outside compose, e.g. local dev:
# DATABASE_URL=postgresql+psycopg://darai:darai@127.0.0.1:5432/darai

# --- web ---
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8080
COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# --- uploads / jobs ---
MAX_UPLOAD_MB=500
MAX_AUDIO_SECONDS=10800
FFMPEG_TIMEOUT_SECONDS=900
MAX_CONCURRENT_JOBS=1
PRELOAD_MODELS=false

# --- local models (read-only mount; nothing is downloaded at runtime) ---
MODELS_HOST_DIR=./models
# Paths inside the container; defaults derive from MODELS_DIR=/models:
# ASR_MODEL_PATH=/models/faster-whisper-large-v3
# DIARIZATION_CONFIG_PATH=/models/pyannote/speaker-diarization-3.1/config.yaml
# EMBEDDING_MODEL_PATH=/models/pyannote/wespeaker-voxceleb-resnet34-LM
# SEGMENTATION_MODEL_PATH=/models/pyannote/segmentation-3.0
ASR_MODEL_ID=faster-whisper-large-v3
ASR_DEVICE=auto
ASR_COMPUTE_TYPE=int8
ASR_LANGUAGE=
ASR_BEAM_SIZE=5
ASR_CPU_THREADS=0
# language handling for RU/KZ/mixed speech (read by the AI pipeline)
ASR_MULTILINGUAL=true
ASR_REFINE_LANGUAGES=true
ASR_ALLOWED_LANGUAGES=ru,kk,en
ASR_LANGUAGE_MIN_PROB=0.5
ASR_VAD_FILTER=true
# empty = let pyannote estimate the number of speakers
DIARIZATION_MAX_SPEAKERS=
TORCH_DEVICE=cpu
INSTALL_ML=true
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
BACKEND_MEMORY_LIMIT=16g

# --- voice identification (cosine similarity thresholds, calibrate on fixtures) ---
VOICE_MODEL_ID=pyannote/wespeaker-voxceleb-resnet34-LM
# local = take the sha from <EMBEDDING_MODEL_PATH>/REVISION written by scripts/ai/prepare_models.py
VOICE_MODEL_REVISION=local
VOICE_EMBEDDING_DIM=256
VOICE_MIN_SEGMENT_SECONDS=1.5
VOICE_MATCH_THRESHOLD=0.55
VOICE_MATCH_MARGIN=0.08
VOICE_ENROLL_MIN_SECONDS=15
VOICE_ENROLL_CHUNK_SECONDS=3
VOICE_ENROLL_CONSISTENCY_THRESHOLD=0.5
VOICE_MAX_SEGMENTS_PER_SPEAKER=30
VOICE_CLIPPING_REVIEW_RATIO=0.001
VOICE_CLIPPING_REJECT_RATIO=0.02
ALIGN_MAX_GAP_SECONDS=1.0
ALIGN_AMBIGUITY_RATIO=0.6

# --- LLM: local OpenAI-compatible endpoint only (Ollama / vLLM) ---
# In compose the bundled `ollama` service is used. For Ollama on the host use
# docker-compose.host-llm.yml (LLM_BASE_URL=http://host.docker.internal:11434/v1).
LLM_BASE_URL=http://ollama:11434/v1
# Required. Must be pulled during preparation. ":cloud" models are refused.
LLM_MODEL=qwen3:8b
LLM_TIMEOUT_SECONDS=180
LLM_TEMPERATURE=0
LLM_WINDOW_UTTERANCES=40
LLM_WINDOW_OVERLAP=6
LLM_SUMMARY_MAX_CHARS=24000
LLM_THINKING_CONTROL=ollama
TASK_LOW_CONFIDENCE=0.6
OLLAMA_HOST_DIR=./models/ollama

# --- export ---
SOFFICE_PATH=soffice
SOFFICE_TIMEOUT_SECONDS=120
EXPORT_FONT=DejaVu Sans

# --- live browser recording (docs/LIVE_CONTRACT.md) ---
LIVE_MAX_CHUNK_BYTES=5242880
LIVE_IDLE_TIMEOUT_SECONDS=120
LIVE_POLL_AFTER_MS=2000
LIVE_PREVIEW_MIN_NEW_BYTES=48000
LIVE_PREVIEW_ENABLED=true

# --- notifications ---
REMINDERS_ENABLED=true
REMINDER_INTERVAL_SECONDS=60
REMINDER_LEAD_HOURS=24

LOG_LEVEL=INFO
